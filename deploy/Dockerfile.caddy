FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build
RUN go install github.com/caddyserver/xcaddy/cmd/xcaddy@v0.4.5
RUN CGO_ENABLED=0 xcaddy build v2.11.6 --output /out/caddy
FROM build AS verify
RUN mkdir /probe && cd /probe && go mod init ci-probe && printf 'package main\nimport _ "github.com/caddyserver/caddy/v2/modules/standard"\nfunc main() {}\n' > main.go && go get github.com/caddyserver/caddy/v2@v2.11.6 && go mod tidy && go mod why golang.org/x/crypto/openpgp
RUN go install golang.org/x/vuln/cmd/govulncheck@v1.8.0 && govulncheck -mode=binary /out/caddy

# Keep the official runtime layout, replacing its older Go binary.
FROM caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
COPY --from=build /out/caddy /usr/bin/caddy
